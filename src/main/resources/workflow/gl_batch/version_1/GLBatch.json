{
  "version": "1.0",
  "name": "GLBatch",
  "desc": "Month-end GL batch workflow with maker/checker controls and validation pattern",
  "initialState": "initial",
  "active": true,
  "states": {
    "initial": {
      "transitions": [
        {
          "name": "create_batch",
          "next": "open",
          "manual": false,
          "criterion": {
            "type": "function",
            "function": {
              "name": "GLBatchValidationCriterion",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          }
        },
        {
          "name": "validation_failed",
          "next": "validation_error",
          "manual": false,
          "criterion": {
            "type": "function",
            "function": {
              "name": "GLBatchValidationFailedCriterion",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          },
          "processors": [
            {
              "name": "AttachGLBatchValidationErrorProcessor",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        }
      ]
    },
    "validation_error": {
      "transitions": [
        {
          "name": "FIX",
          "next": "initial",
          "manual": true,
          "processors": [
            {
              "name": "ClearValidationErrorReasonProcessor",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        }
      ]
    },
    "open": {
      "transitions": [
        {
          "name": "prepare_batch",
          "next": "prepared",
          "manual": true,
          "processors": [
            {
              "name": "SummarizePeriod",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 60000,
                "retryPolicy": "FIXED"
              }
            },
            {
              "name": "CalculateControlTotals",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        }
      ]
    },
    "prepared": {
      "transitions": [
        {
          "name": "approve_export_maker",
          "next": "maker_approved",
          "manual": true,
          "criterion": {
            "type": "function",
            "function": {
              "name": "ControlTotalsBalanced",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          },
          "processors": [
            {
              "name": "RecordMakerApproval",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        },
        {
          "name": "reject_batch",
          "next": "open",
          "manual": true
        }
      ]
    },
    "maker_approved": {
      "transitions": [
        {
          "name": "approve_export_checker",
          "next": "exported",
          "manual": true,
          "criterion": {
            "type": "function",
            "function": {
              "name": "MakerCheckerDifferentUsers",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          },
          "processors": [
            {
              "name": "RecordCheckerApproval",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            },
            {
              "name": "GenerateExportFile",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            },
            {
              "name": "SendToGLSystem",
              "executionMode": "ASYNC_NEW_TX",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 30000,
                "retryPolicy": "EXPONENTIAL_BACKOFF"
              }
            }
          ]
        },
        {
          "name": "reject_batch",
          "next": "open",
          "manual": true
        }
      ]
    },
    "exported": {
      "transitions": [
        {
          "name": "receive_acknowledgment",
          "next": "posted",
          "manual": false,
          "criterion": {
            "type": "function",
            "function": {
              "name": "GLAcknowledgmentReceived",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          }
        }
      ]
    },
    "posted": {
      "transitions": [
        {
          "name": "archive_batch",
          "next": "archived",
          "manual": true,
          "processors": [
            {
              "name": "ArchiveBatch",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application",
                "responseTimeoutMs": 10000,
                "retryPolicy": "FIXED"
              }
            }
          ]
        }
      ]
    },
    "archived": {
      "transitions": []
    }
  }
}

